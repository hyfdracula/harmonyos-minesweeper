{
  "app": {
    "signingConfigs": [
      // 模板：签名材料不要提交到版本库，真机签名请在 DevEco 里登录账号自动生成，
      // 生成后把本文件改名为 build-profile.json5 覆盖使用。
      {
        "name": "default",
        "type": "default",
        "material": {
          "storeFile": "<你的 keystore .p12 路径>",
          "storePassword": "<口令>",
          "keyAlias": "<别名>",
          "keyPassword": "<口令>",
          "signAlg": "SHA256withECDSA",
          "profile": "<你的 .p7b 路径>",
          "certpath": "<你的 .cer 路径>"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
